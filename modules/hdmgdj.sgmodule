#!name=黄豆短剧 (hdmgdj)
#!desc=黄豆短剧（hdmgdj 系）：去广告/启动页、会员与金币显示、剧集列表去付费标记。付费集正片由服务端闸门控制，无法客户端解锁，只能降级为公开试看片。
#!category=Video
#!arguments=previewFallback:true,previewFile:preview-r10.mp4,stripAds:true,fakeVip:true,debug:false
#!arguments-desc=- previewFallback：付费集改播公开试看片（true/false，false 则保留原付费弹窗）\n- previewFile：试看文件名（preview-r10.mp4=10.5 秒，preview.mp4=6 秒）\n- stripAds：去广告/启动页/弹窗（true/false）\n- fakeVip：「我的」页显示会员与余额（true/false）\n- debug：输出调试日志（true/false）

[Script]
# 请求阶段：仅 drama/play 需要，缓存请求体以便响应阶段还原 drama_id / seq
hdmgdj-req = type=http-request, pattern="^https?:\/\/(?:[a-z0-9-]+\.)*(?:pbahpylc\.cc|zxpxzvza\.cc|cbzegnsi\.cc|svlyibwt\.cc|hddj01\.com|hddj02\.com|hddj03\.com|bhanpslw\.top|ftvshtpa\.top|qlczebty\.top|mocqhwfk\.top|uwfjkoxh\.cc|hddj08\.com|hddj09\.com|hddj22\.com|nsokaymn\.cc|iwgsqufx\.cc|nbsito\.top|tideember\.cc|momodrift\.top|zuzuspot\.top|zuzucast\.top|glowcanvas\.cc|eyeonneb\.cc|larksummit\.icu|niniharbor\.top|kucvcxrv\.cc|onyxripple\.cc|ferncider\.cc|larkgarden\.top|vivifable\.top|sxqirtho\.top|qicuknlj\.top|hvthtcpa\.top|hdmgdj\.com|seiopcc\.icu|vhuoksd\.wiki|nptmguft\.cc|lyfxoxpf\.cc|exmuiawd\.cc|svkexyoz\.cc|halobloom\.cc|mintgate\.top)\/api\/drama\/play", requires-body=1, binary-body-mode=1, max-size=0, timeout=30, script-path=https://raw.githubusercontent.com/olivercxu/shiny-octo-funicular/main/scripts/hdmgdj.js, argument=previewFallback={{{previewFallback}}}&previewFile={{{previewFile}}}&stripAds={{{stripAds}}}&fakeVip={{{fakeVip}}}&debug={{{debug}}}
# 响应阶段：解密 → 改写 → 重新加密
hdmgdj-resp = type=http-response, pattern="^https?:\/\/(?:[a-z0-9-]+\.)*(?:pbahpylc\.cc|zxpxzvza\.cc|cbzegnsi\.cc|svlyibwt\.cc|hddj01\.com|hddj02\.com|hddj03\.com|bhanpslw\.top|ftvshtpa\.top|qlczebty\.top|mocqhwfk\.top|uwfjkoxh\.cc|hddj08\.com|hddj09\.com|hddj22\.com|nsokaymn\.cc|iwgsqufx\.cc|nbsito\.top|tideember\.cc|momodrift\.top|zuzuspot\.top|zuzucast\.top|glowcanvas\.cc|eyeonneb\.cc|larksummit\.icu|niniharbor\.top|kucvcxrv\.cc|onyxripple\.cc|ferncider\.cc|larkgarden\.top|vivifable\.top|sxqirtho\.top|qicuknlj\.top|hvthtcpa\.top|hdmgdj\.com|seiopcc\.icu|vhuoksd\.wiki|nptmguft\.cc|lyfxoxpf\.cc|exmuiawd\.cc|svkexyoz\.cc|halobloom\.cc|mintgate\.top)\/api\/(?:drama|movie|user|up|pay|mine|ad|lottery|task|product|redeem|comment|system|home|search)\/.+", requires-body=1, binary-body-mode=1, max-size=0, timeout=30, script-path=https://raw.githubusercontent.com/olivercxu/shiny-octo-funicular/main/scripts/hdmgdj.js, argument=previewFallback={{{previewFallback}}}&previewFile={{{previewFile}}}&stripAds={{{stripAds}}}&fakeVip={{{fakeVip}}}&debug={{{debug}}}

[MITM]
hostname = %APPEND% pbahpylc.cc, zxpxzvza.cc, cbzegnsi.cc, svlyibwt.cc, hddj01.com, hddj02.com, hddj03.com, bhanpslw.top, ftvshtpa.top, qlczebty.top, mocqhwfk.top, uwfjkoxh.cc, hddj08.com, hddj09.com, hddj22.com, nsokaymn.cc, iwgsqufx.cc, nbsito.top, tideember.cc, momodrift.top, zuzuspot.top, zuzucast.top, glowcanvas.cc, eyeonneb.cc, larksummit.icu, niniharbor.top, kucvcxrv.cc, onyxripple.cc, ferncider.cc, larkgarden.top, vivifable.top, sxqirtho.top, qicuknlj.top, hvthtcpa.top, hdmgdj.com, seiopcc.icu, vhuoksd.wiki, nptmguft.cc, lyfxoxpf.cc, exmuiawd.cc, svkexyoz.cc, halobloom.cc, mintgate.top
